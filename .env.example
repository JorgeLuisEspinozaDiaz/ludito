# URL del backend (Render). Sin barra final.
# Local: http://localhost:3001
# Producción: https://TU-SERVICIO.onrender.com
VITE_WS_URL=http://localhost:3001

# TURN recomendado en producción (Vercel ↔ redes distintas).
# Gratis: crea cuenta en https://www.metered.ca/tools/openrelay/
# o usa un servidor coturn propio.
# Puedes poner varias URLs separadas por coma.
# VITE_TURN_URL=turn:TU_HOST:80,turns:TU_HOST:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
